# ---- Database (Postgres — e.g. Supabase's connection string in production) ----
# In production, DATABASE_URL is the pooled (PgBouncer) connection and DIRECT_URL
# is a direct/session connection used only by the Prisma CLI for schema DDL.
# Locally, point both at the same direct connection.
DATABASE_URL="postgresql://user:password@localhost:5432/gms_tkd_dev"
DIRECT_URL="postgresql://user:password@localhost:5432/gms_tkd_dev"

# ---- Session signing (CHANGE IN PRODUCTION) ----
SESSION_SECRET="change-me-in-production-min-32-characters-long-secret"

# ---- Seed super admin ----
SEED_ADMIN_EMAIL="admin@taekwondogms.org"
SEED_ADMIN_PASSWORD="Admin@123"

# ---- Email (leave SMTP_HOST empty to use the local file outbox at ./storage/outbox) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Taekwondo GMS <no-reply@taekwondogms.org>"

# ---- Public base URL (used inside QR codes on cards/certificates) ----
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---- SMS / WhatsApp (Twilio) — leave TWILIO_ACCOUNT_SID empty to use the local file outbox ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# Participant photos. Without these the app writes to public/uploads/photos,
# which only works locally — on Vercel that path is read-only and uploads are
# lost. Set all three in any deployed environment.
# The bucket must be PRIVATE: photos are served through /api/photos/[id],
# which checks the session first.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=participant-photos
