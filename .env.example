# ---- Database (Postgres — e.g. Supabase's connection string in production) ----
DATABASE_URL="postgresql://user:password@localhost:5432/gms_tkd_dev"

# ---- Session signing (CHANGE IN PRODUCTION) ----
SESSION_SECRET="change-me-in-production-min-32-characters-long-secret"

# ---- Seed super admin ----
SEED_ADMIN_EMAIL="admin@prsnair-taekwondo.org"
SEED_ADMIN_PASSWORD="Admin@123"

# ---- Email (leave SMTP_HOST empty to use the local file outbox at ./storage/outbox) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="P.R.S Nair Taekwondo Championship <no-reply@prsnair-taekwondo.org>"

# ---- Public base URL (used inside QR codes on cards/certificates) ----
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---- SMS / WhatsApp (Twilio) — leave TWILIO_ACCOUNT_SID empty to use the local file outbox ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
