{
  "name": "gms-tkd",
  "version": "1.0.0",
  "private": true,
  "description": "Taekwondo GMS - Taekwondo Game Management System",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "15.5.24",
    "nodemailer": "9.0.6",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.26",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.2",
    "vitest": "^4.1.11"
  }
}
